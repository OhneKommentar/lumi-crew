# Homebrew formula for Lumi Crew. Generated by scripts/release.sh from packaging/lumi-crew.rb.tmpl.
class LumiCrew < Formula
  desc "Multi-agent coding CLI: orchestrator, planner, coder, reviewer, tester"
  homepage "https://github.com/OhneKommentar/lumi-crew"
  url "https://github.com/OhneKommentar/lumi-crew/archive/refs/tags/v@VERSION@.tar.gz"
  sha256 "@SHA256@"

  depends_on "python@3.14"

  def install
    python = formula_opt_bin("python@3.14")/"python3.14"
    system python, "-m", "venv", libexec
    system libexec/"bin/pip", "install", "--no-cache-dir", "--disable-pip-version-check", buildpath
    # watchfiles (optional reload helper pulled in by the MCP stack, unused by Lumi Crew) ships a Rust
    # extension without header padding, which breaks Homebrew's dylib relocation.
    system libexec/"bin/pip", "uninstall", "-y", "--disable-pip-version-check", "watchfiles"
    bin.install_symlink libexec/"bin/lumi-crew"
  end

  def caveats
    <<~EOS
      Lumi Crew needs at least one model provider: the agy, claude or codex CLI (logged in),
      a local Ollama / LM Studio server, or an API key. Check with:
        lumi-crew providers
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/lumi-crew --version")
  end
end
